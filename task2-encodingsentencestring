#include <stdio.h>

// Function takes a pointer to a string
// and encodes its lowercase letters
//void because returns nothing(no count,etc)- has no returning statement it uses breakand just just modifiies o.g string through pointer
void code(char *str)
{
    // Original lowercase alphabet
    char code1[] = "abcdefghijklmnopqrstuvwxyz";

    // Encoded letters corresponding to code1
    char code2[] = "bpduhijkaltxwmrzfoysvngeqc";

    int i, j; // Loop counters

    // Go through each character in the input string
    for (i = 0; str[i] != '\0'; i++)//outer loop 
    {
        // Search for the current character in code1
        for (j = 0; code1[j] != '\0'; j++)//inner loop
        {
            // Check whether the character matches code1[j]
            if (str[i] == code1[j])
            {
                // Replace it with the encoded letter
                // at the same index in code2
                str[i] = code2[j];

                // Stop searching once the letter is found
                break;
            }
        }

        // If the character is not found in code1,
        // it remains unchanged.
        // This preserves uppercase letters, spaces,
        // and punctuation.
    }
}

int main(void)
{
    // Create a modifiable/encoded string to encode
    char cat[] = "The cat sat on the mat.";

    // Show the original string
    printf("String was : %s\n", cat);

    // Encode the string
    code(cat);

    // Show the encoded string
    printf("String is : %s\n", cat);

    return 0; // End the program 
}
